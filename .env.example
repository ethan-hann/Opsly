# .env.example — copy to .env and customize for local development.
#
# Docker:  cp .env.example .env && docker compose -f docker-compose.local.yml up --build
# Native:  cp .env.example .env && pnpm run setup && pnpm run dev
#
# Docker Compose reads .env automatically (no --env-file flag needed).
# The native dev scripts (scripts/dev.sh / scripts/dev.ps1) also source .env.

# ── Database ──────────────────────────────────────────────────────────────────
# Native dev: point at your local Postgres instance.
# Docker dev: leave as-is (the compose stack uses its own internal URL).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/opsly

# ── Auth mode ─────────────────────────────────────────────────────────────────
# local — email/password login, no external IdP required (default)
# oidc  — generic OIDC provider (fill in OIDC_* vars below)
AUTH_MODE=local

# ── Local auth bootstrap user ─────────────────────────────────────────────────
# Created automatically on first startup when AUTH_MODE=local.
LOCAL_DEV_USER_EMAIL=admin@example.com
LOCAL_DEV_USER_PASSWORD=changeme
LOCAL_DEV_USER_FIRST_NAME=Local
LOCAL_DEV_USER_LAST_NAME=Admin
LOCAL_DEV_USER_INSTANCE_ADMIN=true

# ── Generic OIDC (AUTH_MODE=oidc) ────────────────────────────────────────────
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# ── Storage ───────────────────────────────────────────────────────────────────
# local — write export files to LOCAL_STORAGE_PATH on disk (default)
# s3    — any S3-compatible store (fill in S3_* vars below)
STORAGE_DRIVER=local

# Directory used by STORAGE_DRIVER=local. Created automatically if missing.
LOCAL_STORAGE_PATH=./data/exports

# ── S3 storage (STORAGE_DRIVER=s3) ───────────────────────────────────────────
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=          # omit for AWS S3; set for MinIO, Cloudflare R2, etc.
# STORAGE_PREFIX=exports/

# ── Instance admin token ──────────────────────────────────────────────────────
# Static bearer token that grants instance-admin access. Change this in
# any environment that is reachable from the network.
INSTANCE_ADMIN_TOKEN=local-dev-admin-token
