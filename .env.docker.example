# Copy to .env.docker and customize:
#   Copy-Item .env.docker.example .env.docker
# Then run:
#   docker compose --env-file .env.docker -f docker-compose.local.yml up --build

# --- Auth mode ---
# local | replit_oidc | oidc
AUTH_MODE=local

# --- Local mode bootstrap user ---
LOCAL_DEV_USER_EMAIL=admin@example.com
LOCAL_DEV_USER_PASSWORD=changeme
LOCAL_DEV_USER_FIRST_NAME=Local
LOCAL_DEV_USER_LAST_NAME=Admin

# --- Replit OIDC mode ---
REPL_ID=
ISSUER_URL=https://replit.com/oidc

# --- Generic OIDC mode ---
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# --- Instance admin fallback ---
INSTANCE_ADMIN_TOKEN=local-dev-admin-token
