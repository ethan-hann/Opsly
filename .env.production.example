# .env.production.example — Copy to .env.production and fill in real values.
#
# Usage:
#   cp .env.production.example .env.production
#   # Edit .env.production with your real values (never commit it)
#   docker compose --env-file .env.production up -d
#
# See SELF_HOSTING.md for the full setup guide including security notes.

# ── Database ──────────────────────────────────────────────────────────────────
# Credentials for the Postgres container managed by this compose stack.
# If you use an external/managed database, set DATABASE_URL directly below
# and remove the POSTGRES_* vars (they are only used by the db service).
POSTGRES_DB=opsly
POSTGRES_USER=opsly
POSTGRES_PASSWORD=change-me-use-a-strong-random-password

# Override the full DATABASE_URL only when using an external database.
# If unset, the compose file builds it from POSTGRES_USER/PASSWORD/DB above.
# DATABASE_URL=postgresql://opsly:password@your-db-host:5432/opsly

# ── Auth mode ─────────────────────────────────────────────────────────────────
# local — email/password login (default; requires BOOTSTRAP_ADMIN_* below)
# oidc  — generic OIDC provider (fill in OIDC_* below)
AUTH_MODE=local

# ── Generic OIDC (AUTH_MODE=oidc) ────────────────────────────────────────────
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# ── Security (required) ───────────────────────────────────────────────────────
# SESSION_SECRET: signs session cookies. Use a long random string (≥32 chars).
#   Generate: openssl rand -hex 32
SESSION_SECRET=change-me-generate-with-openssl-rand-hex-32

# SECRET_ENCRYPTION_KEY: AES-256-GCM key for encrypting credentials at rest.
#   Must be exactly 64 hex characters (32 bytes).
#   Generate: openssl rand -hex 32
SECRET_ENCRYPTION_KEY=change-me-generate-with-openssl-rand-hex-32

# INSTANCE_ADMIN_TOKEN: static bearer token granting instance-admin access.
#   Used by the /api/admin/* routes. Keep this secret.
#   Generate: openssl rand -hex 32
INSTANCE_ADMIN_TOKEN=change-me-generate-with-openssl-rand-hex-32

# ── First-run bootstrap (AUTH_MODE=local only) ────────────────────────────────
# Creates the initial admin user on first startup.
# Safe to leave set — create-local-user is idempotent (skips if user exists).
# Remove or blank these after first startup if you prefer not to keep credentials here.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-use-a-strong-password
BOOTSTRAP_ADMIN_FIRST_NAME=Admin
BOOTSTRAP_ADMIN_LAST_NAME=User

# ── Network binding ───────────────────────────────────────────────────────────
# Bind the API port only to localhost so the reverse proxy is the only
# public entry point. Set BIND_ADDRESS=0.0.0.0 only if you know what you're doing.
BIND_ADDRESS=127.0.0.1
HOST_PORT=8080

# ── Storage ───────────────────────────────────────────────────────────────────
# local — write export files to the opsly-exports Docker volume (default)
# s3    — any S3-compatible store (AWS S3, MinIO, Cloudflare R2, etc.)
STORAGE_DRIVER=local

# S3-compatible storage (STORAGE_DRIVER=s3)
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=http://minio:9000   # omit for AWS; set for MinIO, R2, B2, etc.
# STORAGE_PREFIX=exports/

# ── Email / SMTP ─────────────────────────────────────────────────────────────
# SMTP is required for users to reset their own passwords. Without it, password
# resets must be done manually by an admin. It is also used for notification
# emails and digest summaries. Configure here or via Admin → Email after login.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Opsly <noreply@example.com>

# ── Docker image ──────────────────────────────────────────────────────────────
# Set to a registry image tag to use a pre-built image instead of building locally.
# Example: OPSLY_IMAGE=ghcr.io/your-org/opsly-api:1.2.3
# OPSLY_IMAGE=opsly-api:latest
