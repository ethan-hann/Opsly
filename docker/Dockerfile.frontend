# Dockerfile.frontend — Multi-stage production image for the Opsly web frontend.
#
# Stages:
#   deps    — install all workspace dependencies (lockfile-cached layer)
#   builder — compile the Vite/React bundle into static assets
#   runner  — nginx serving the static bundle + /api/* reverse-proxied to the API
#
# Build:
#   docker build -f Dockerfile.frontend -t opsly-web:latest .
#
# The compiled frontend serves on port 80 inside the container.
# All /api/* requests are forwarded to the api service on the internal network.

# ── Stage 1: install all dependencies ─────────────────────────────────────────
# Cached as long as pnpm-lock.yaml and workspace package.json files don't change.
FROM node:24-bookworm-slim AS deps

WORKDIR /app

ENV PNPM_HOME="/pnpm"
ENV PATH="${PNPM_HOME}:${PATH}"
ENV PNPM_STORE_PATH="/pnpm/store"

RUN corepack enable

# Copy only the files that affect dependency resolution so source-code changes
# don't bust this expensive layer.
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY scripts/package.json scripts/preinstall.js ./scripts/
COPY artifacts/api-server/package.json ./artifacts/api-server/
COPY artifacts/it-task-manager/package.json ./artifacts/it-task-manager/
COPY lib/api-client-react/package.json ./lib/api-client-react/
COPY lib/api-spec/package.json ./lib/api-spec/
COPY lib/api-zod/package.json ./lib/api-zod/
COPY lib/db/package.json ./lib/db/
COPY lib/auth-web/package.json ./lib/auth-web/

RUN pnpm install --frozen-lockfile

# ── Stage 2: build ─────────────────────────────────────────────────────────────
FROM deps AS builder

# Copy all source now that node_modules are in place.
COPY . .

# PORT is validated by vite.config.ts at config-load time but is never used
# during `vite build` (no server starts). A placeholder value satisfies the check.
ENV PORT=3000
# Deploy at the root path — self-hosted instances always run at /.
ENV BASE_PATH=/
ENV NODE_ENV=production

# Compile the frontend bundle (Vite → artifacts/it-task-manager/dist/public/).
RUN pnpm --filter @workspace/it-task-manager run build

# ── Stage 3: runtime ───────────────────────────────────────────────────────────
# Slim nginx image: serves pre-compiled static assets and proxies /api/* to the
# api container over the internal Docker network.
FROM nginx:1.27-alpine AS runner

# Copy the compiled static bundle.
COPY --from=builder /app/artifacts/it-task-manager/dist/public /usr/share/nginx/html

# Custom nginx config: SPA fallback + /api/ proxy + asset caching.
COPY docker/nginx.frontend.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
