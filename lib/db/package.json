{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "push": "drizzle-kit push --config ./drizzle.config.ts",
    "push-force": "drizzle-kit push --force --config ./drizzle.config.ts",
    "seed": "npx tsx src/seed-org.ts",
    "migrate:backfill-comments-org-id": "pnpm dlx tsx src/migrations/backfill-comments-org-id.ts",
    "migrate:add-inbound-webhook-rate-limit": "pnpm dlx tsx src/migrations/add-inbound-webhook-rate-limit.ts",
    "migrate:add-outbound-webhook-deliveries": "pnpm dlx tsx src/migrations/add-outbound-webhook-deliveries.ts",
    "migrate:add-roles-and-permissions": "pnpm dlx tsx src/migrations/add-roles-and-permissions.ts",
    "migrate:add-custom-fields": "pnpm dlx tsx src/migrations/add-custom-fields.ts",
    "migrate:create-task-events": "pnpm dlx tsx src/migrations/create-task-events.ts",
    "migrate:create-saved-views": "pnpm dlx tsx src/migrations/create-saved-views.ts",
    "migrate:create-sla-policies": "pnpm dlx tsx src/migrations/create-sla-policies.ts",
    "migrate:add-project-sla-overrides": "pnpm dlx tsx src/migrations/add-project-sla-overrides.ts",
    "migrate:add-sla-warning-support": "pnpm dlx tsx src/migrations/add-sla-warning-support.ts",
    "migrate:create-workflow-stages": "pnpm dlx tsx src/migrations/create-workflow-stages.ts",
    "migrate:add-search-trigram-indexes": "pnpm dlx tsx src/migrations/add-search-trigram-indexes.ts",
    "migrate:add-inbound-webhook-task-template-id": "pnpm dlx tsx src/migrations/add-inbound-webhook-task-template-id.ts",
    "migrate:add-task-watchers": "pnpm dlx tsx src/migrations/add-task-watchers.ts"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.22.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10"
  }
}
